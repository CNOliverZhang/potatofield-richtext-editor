{
  "appId": "cn.potatofield.richtexteditor",
  "productName": "洋芋田富文本编辑器",
  "copyright": "Copyright © 2026 ${author}",
  "asar": true,
  "asarUnpack": ["**/node_modules/sharp/**/*", "**/node_modules/@img/**/*"],
  "directories": {
    "output": "release/${version}",
    "buildResources": "resources"
  },
  "files": ["dist"],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "potatofield-richtexteditor-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "mac": {
    "identity": "Shenzhen Potato Field Technology Consulting Co., Ltd (T657YWLL39)",
    "target": [{
      "target": "default",
      "arch": ["universal"]
    }],
    "artifactName": "potatofield-richtexteditor-${version}.${ext}"
  },
  "linux": {
    "target": ["AppImage"],
    "artifactName": "potatofield-richtexteditor-${version}.${ext}"
  },
  "releaseInfo": {
    "releaseNotes": "修复了复制富文本到微信公众号后代码块排版错乱的问题。\n修复了代码块中的换行在公众号中丢失的问题。\n长代码行不再被自动折行，超出宽度时可左右滑动查看完整代码。"
  },
  "afterSign": "scripts/notarize.js",
  "publish": [
    {
      "provider": "generic",
      "url": "https://files.potatofield.cn/RichTextEditor/Packages"
    }
  ]
}
